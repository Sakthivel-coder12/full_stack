<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>The result</h1>
    <table>
        <tr>
            <th>First name</th>
            <th>Last name</th>
            <th>gender</th>
            <th>phone </th>
        </tr>
        <% students.forEach(student=>{ %>
         <tr>
            <td><%= student.fname %></td>
            <td><%= student.lname %></td>
            <td><%= student.gender %></td>
            <td><%= student.phone %></td>
            <td><a href="/find/<%= student.fname %>">delete</a></td>
         </tr>
        <% })%>
    </table>
    
</body>
</html>