<!DOCTYPE html>
<html>
<head>
    <title>Student Form</title>
</head>
<body>
    <h2>Student Form</h2>
    <form method="POST" action="/submit">
        Reg No: <input type="text" name="regno" value="<%= data ? data.regno : '' %>" required><br>
        Name: <input type="text" name="name" value="<%= data ? data.name : '' %>" required><br>
        Marks:
        <input type="number" name="marks" value="<%= data ? data.marks[0] : '' %>" required>
        <input type="number" name="marks" value="<%= data ? data.marks[1] : '' %>" required>
        <input type="number" name="marks" value="<%= data ? data.marks[2] : '' %>" required><br>
        <button type="submit">Submit</button> 
    </form>

    <% if (data) { %>
        <h3>Results</h3>
        Total: <%= data.total %><br>
        Average: <%= data.average %>
    <% } %>
</body>
</html>
